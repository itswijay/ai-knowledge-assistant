# PostgreSQL must have the pgvector extension available.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# Supabase Auth project origin. JWT issuer and JWKS URLs are derived from it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_CACHE_TTL_SECONDS=600

# Create an API key in Google AI Studio. Never commit the real value.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_LLM_MODEL=gemini-3.7-flash
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Fixed by the current database schema. Any value other than 768 is rejected.
EMBEDDING_DIMENSION=768

# Tune retrieval settings by evaluation.
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65

# PDF upload limit per assistant.
MAX_UPLOAD_SIZE_MB=10

# Optional destructive PostgreSQL isolation test. Use a separate disposable,
# fully migrated database and enable explicitly when running the test.
# RUN_POSTGRES_INTEGRATION_TESTS=1
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/assistant_test
